# General
ENVIRONMENT=development
PROJECT_NAME="AI Career Intelligence Platform"

# Backend & FastAPI
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeythatyoushouldchangetoarandomstringinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicareerdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# Note: For Vercel Deployment, set DATABASE_URL to your Neon DB string in the Vercel Dashboard

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# LLM Providers
LLM_API_KEY=your-llm-api-key-hereR

# Storage
STORAGE_BUCKET=aicareer-storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
